# The App Store side of the release: the listing in fastlane/metadata and
# the framed screenshots in Scripts/store/out go up with `deliver`. The
# direct-download DMG is Scripts/release-dmg.sh and does not come through
# here.
#
# Needs an App Store Connect API key: ASC_KEY_ID, ASC_ISSUER_ID and
# ASC_KEY_PATH, the same three release-dmg.sh uses.

require "tmpdir"
require "fileutils"

default_platform(:mac)

BUNDLE_ID = "it.typeme.typemeit"
SCREENSHOTS = File.expand_path("../Scripts/store/out", __dir__)
# The order the store shows them in.
ORDER = %w[slack claude insights history settings]

# sync_screenshots is gated behind this until fastlane calls it stable.
ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

platform :mac do
  desc "Print the app record App Store Connect holds for the bundle id, or say there is none"
  lane :store_status do
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if app
      UI.message("#{app.name} (#{app.bundle_id}) sku=#{app.sku} id=#{app.id}")
      app.get_app_store_versions.each { |v| UI.message("  #{v.platform} #{v.version_string}: #{v.app_store_state}") }
    else
      UI.important("no app record for #{BUNDLE_ID}; create one in App Store Connect before `deliver`")
    end
  end

  desc "Upload the listing text and screenshots. Uploads no build and submits nothing for review.
        `listing metadata:false` sends the screenshots alone: deliver's metadata pass reads the
        version's App Review contact, which a new version does not have until it is filled in once
        in App Store Connect. `listing version:1.0.1` names the version the text goes on, creating
        it if the store has none in preparation"
  lane :listing do |options|
    api_key
    screenshots = Dir[File.join(SCREENSHOTS, "*.png")].sort
    UI.user_error!("no screenshots in #{SCREENSHOTS}; run python3 Scripts/store/build.py") if screenshots.empty?
    # deliver reads screenshots from a locale folder, and orders them by file
    # name; the frames are staged as 1_slack.png ... so the store shows them
    # in the order below.
    staged = Dir.mktmpdir("store-screenshots")
    locale = File.join(staged, "en-US")
    FileUtils.mkdir_p(locale)
    ORDER.each_with_index do |name, i|
      file = File.join(SCREENSHOTS, "#{name}.png")
      UI.user_error!("missing #{file}") unless File.exist?(file)
      FileUtils.cp(file, File.join(locale, "#{i + 1}_#{name}.png"))
    end
    deliver(
      app_identifier: BUNDLE_ID,
      platform: "osx",
      app_version: options[:version],
      metadata_path: "./fastlane/metadata",
      screenshots_path: staged,
      # Checksums decide what goes up, so an unchanged frame is left alone
      # and nothing is deleted and re-verified before the store has
      # processed it, which is what doubled every screenshot once.
      sync_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: options[:metadata] == false,
      skip_app_version_update: options[:version].nil?,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Attach an uploaded build to the version and submit it for review:
        `submit version:1.0.1 build:202609201117`. Waits for the build to finish processing.
        The release is manual: approved, it goes on sale when released in App Store Connect"
  lane :submit do |options|
    api_key
    deliver(
      app_identifier: BUNDLE_ID,
      platform: "osx",
      app_version: options.fetch(:version),
      build_number: options.fetch(:build),
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end
end
