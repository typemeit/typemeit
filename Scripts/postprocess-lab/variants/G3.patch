+    static func unitFigures(_ text: String) -> String {
+        let tokens = tokenise(text)
+        var out: [String] = []
+        var i = 0
+        while i < tokens.count {
+            guard tokens[i].isWord, let (value, end, ordinal) = number(in: tokens, from: i), !ordinal else {
