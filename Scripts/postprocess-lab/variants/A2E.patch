+    /// Applies each fix at its first occurrence after the previous one;
+    /// a fix whose `from` is not in the text is skipped.
+    static func apply(_ fixes: [Fix], to text: String) -> String {
+        var out = text
+        var cursor = out.startIndex
+        for f in fixes where !f.from.isEmpty && f.from != f.to {
+            guard let r = out.range(of: f.from, range: cursor..<out.endIndex) ?? out.range(of: f.from, options: .caseInsensitive, range: cursor..<out.endIndex) else { continue }
+            let offset = out.distance(from: out.startIndex, to: r.lowerBound) + f.to.count
+            out.replaceSubrange(r, with: f.to)
+            cursor = out.index(out.startIndex, offsetBy: min(offset, out.count))
+        }
+        return out
+    }
